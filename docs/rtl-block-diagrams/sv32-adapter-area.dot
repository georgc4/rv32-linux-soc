digraph sv32_area {
  graph [rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.7, ranksep=0.6,
         fontname="Helvetica", fontsize=22, fontcolor="#17243a",
         label="Sv32 adapter · Sky130 mapped cells and area", labelloc=t];
  node [shape=box, style="rounded,filled", penwidth=1.5, fontname="Helvetica",
        fontsize=14, margin="0.22,0.16"];
  edge [color="#637895", arrowsize=0.75, penwidth=1.5, dir=both];
  tlb [label="TLB storage FFs\n219 cells · 5,480.3 µm²\nValid / VPN / context / live PTE / level bits", fillcolor="#e9f6ef", color="#5c9b7d"];
  other [label="Other adapter logic\n1,470 cells · 13,925.9 µm²\nTLB lookup mux / compare / walk / A-D / bus / response", fillcolor="#f2f6fb", color="#6380a5"];
  tlb -> other;
  total [shape=plaintext, label="sv32_bus_adapter total\n1,689 cells · 19,406.1 µm²", fontcolor="#17243a", fontsize=16];
  other -> total [style=invis];
}
