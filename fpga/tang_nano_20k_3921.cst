// For Tang Nano 20K PCB 3921 / Sipeed schematic rev 1.30 only.
// Check the physical PCB marking before programming. All pins below are 3.3 V.
IO_LOC "clk_20m" 10; // MS5351 CLK0; configure BL616: pll_clk O0=20M -s
IO_PORT "clk_20m" IO_TYPE=LVCMOS33;
IO_LOC "rst_n" 71; // J5 pin 18; external active-low reset
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Dedicated FPGA <-> onboard BL616 USB-to-UART nets, not JTAG/SPI pins.
IO_LOC "uart_tx" 69; // FPGA PIN69_SYS_TX -> BL616_UART_RX
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 70; // BL616_UART_TX -> FPGA PIN70_SYS_RX
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// External quad memories on the J5/J6 headers. Do not attach LCD/HDMI modules
// to the shared board traces while these pins drive the memory bus.
IO_LOC "spi_sck" 73; // J6 pin 1
IO_PORT "spi_sck" IO_TYPE=LVCMOS33;
IO_LOC "spi_cs_n[0]" 74; // PSRAM 0, J6 pin 2
IO_LOC "spi_cs_n[1]" 77; // PSRAM 1, J6 pin 5
IO_LOC "spi_cs_n[2]" 27; // PSRAM 2, J6 pin 8
IO_LOC "spi_cs_n[3]" 28; // PSRAM 3, J6 pin 9
IO_LOC "spi_cs_n[4]" 25; // NOR, J6 pin 11
IO_PORT "spi_cs_n[0]" IO_TYPE=LVCMOS33;
IO_PORT "spi_cs_n[1]" IO_TYPE=LVCMOS33;
IO_PORT "spi_cs_n[2]" IO_TYPE=LVCMOS33;
IO_PORT "spi_cs_n[3]" IO_TYPE=LVCMOS33;
IO_PORT "spi_cs_n[4]" IO_TYPE=LVCMOS33;
IO_LOC "spi_dq[0]" 26; // shared IO0, J6 pin 10
IO_LOC "spi_dq[1]" 29; // shared IO1, J6 pin 12
IO_LOC "spi_dq[2]" 30; // PSRAM IO2, J6 pin 13
IO_LOC "spi_dq[3]" 31; // PSRAM IO3, J6 pin 14
IO_LOC "spi_dq[4]" 41; // NOR IO2, J5 pin 6
IO_LOC "spi_dq[5]" 42; // NOR IO3, J5 pin 5
IO_PORT "spi_dq[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "spi_dq[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "spi_dq[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "spi_dq[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "spi_dq[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "spi_dq[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
